{
  "rules": {
    ".read": false,
    ".write": false,

    "system_config": { ".read": true, ".write": true },
    "system_notifications": { ".read": true, ".write": true },
    "users_accounts": { ".read": true, ".write": true },
    "team_chat": { ".read": true, ".write": true },
    "stores": { ".read": true, ".write": true },
    "jobs": { ".read": true, ".write": true },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['username', 'role', 'status']) || !newData.exists()",
        "username": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9._-]{2,40}$/)" },
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "role": { ".validate": "newData.val() === 'full' || newData.val() === 'designer' || newData.val() === 'publisher'" },
        "status": { ".validate": "newData.val() === 'active' || newData.val() === 'locked'" },
        "expiresAt": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" }
      }
    },

    "apps": {
      "autoclick": {
        "config": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'active' && (!root.child('users').child(auth.uid).child('expiresAt').exists() || root.child('users').child(auth.uid).child('expiresAt').val() > now)",
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          "enabled": { ".validate": "newData.isBoolean()" },
          "defaultAllow": { ".validate": "newData.isBoolean()" },
          "minVersion": { ".validate": "newData.isString() && newData.val().matches(/^([0-9]+([.][0-9]+){0,2})?$/)" },
          "message": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "$other": { ".validate": false }
        },
        "access": {
          ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
            ".validate": "newData.isBoolean()"
          }
        },
        "usage": {
          ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && root.child('users').child(auth.uid).child('status').val() === 'active' && (!root.child('users').child(auth.uid).child('expiresAt').exists() || root.child('users').child(auth.uid).child('expiresAt').val() > now)))",
            "total": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "days": {
              "$day": { ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber() && newData.val() >= 0" }
            },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "lastAt": { ".validate": "newData.isNumber()" },
            "version": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
